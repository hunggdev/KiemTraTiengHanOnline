datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  TEACHER
  STUDENT
}

enum SkillType {
  LISTENING
  SPEAKING
  READING
  WRITING
}

enum QuestionType {
  MULTIPLE_CHOICE
  ESSAY          // tự luận - viết/nói
  AUDIO_RESPONSE // ghi âm cho phần nói
}

model User {
  id                 Int           @id @default(autoincrement())
  username           String        @unique
  passwordHash       String
  fullName           String
  role               Role          @default(STUDENT)
  classId            Int?
  class              Class?        @relation(fields: [classId], references: [id], onDelete: SetNull)
  canAccessFlashcard Boolean       @default(false) // Quyền sử dụng Flashcard được giáo viên cấp
  createdBy          String?       // id giáo viên tạo tài khoản
  createdAt          DateTime      @default(now())
  attempts           TestAttempt[]
  createdDecks       FlashcardDeck[]
  cardProgress       FlashcardProgress[]
}

model Class {
  id      Int              @id @default(autoincrement())
  name    String
  users   User[]
  tests   TestAssignment[]
}

model Test {
  id          Int              @id @default(autoincrement())
  title       String
  description String?
  durationMin Int              // tổng thời gian làm bài
  sections    TestSection[]
  assignments TestAssignment[]
  createdBy   String
  createdAt   DateTime         @default(now())
  isPublished Boolean          @default(false)
  attempts    TestAttempt[]
}

model TestSection {
  id          Int         @id @default(autoincrement())
  testId      Int
  test        Test        @relation(fields: [testId], references: [id], onDelete: Cascade)
  skill       SkillType
  order       Int
  durationMin Int?        // giới hạn riêng theo phần (tuỳ chọn)
  questions   Question[]
}

model Question {
  id            Int          @id @default(autoincrement())
  sectionId     Int
  section       TestSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  type          QuestionType
  order         Int
  content       String       // text câu hỏi
  audioUrl      String?      // file nghe (Supabase Storage)
  imageUrl      String?
  options       Option[]     // dùng cho MULTIPLE_CHOICE
  correctAnswer String?      // đáp án đúng (id option hoặc text mẫu)
  score         Float        @default(1)
  responses     Response[]
}

model Option {
  id         Int      @id @default(autoincrement())
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String   // A, B, C, D
  content    String
}

model TestAssignment {
  id      Int      @id @default(autoincrement())
  testId  Int
  test    Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  classId Int
  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  openAt  DateTime
  closeAt DateTime
}

model TestAttempt {
  id          Int        @id @default(autoincrement())
  userId      Int
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  testId      Int
  test        Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
  startedAt   DateTime   @default(now())
  submittedAt DateTime?
  status      String     @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED | GRADED | EXPIRED
  totalScore  Float?
  responses   Response[]
}

model Response {
  id         Int         @id @default(autoincrement())
  attemptId  Int
  attempt    TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId Int
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerText String?     // câu trả lời (trắc nghiệm: option id; tự luận: text)
  audioUrl   String?     // file ghi âm phần nói
  isCorrect  Boolean?    // auto-grade cho trắc nghiệm
  scoreGiven Float?      // điểm chấm tay cho tự luận
  gradedBy   String?
  gradedAt   DateTime?
  updatedAt  DateTime    @updatedAt // dùng cho autosave
}

model FlashcardDeck {
  id          Int             @id @default(autoincrement())
  title       String
  description String?
  type        String          @default("VOCABULARY") // VOCABULARY | SENTENCE | GRAMMAR
  language    String          @default("ko")         // ko, en, ja...
  isPublic    Boolean         @default(true)
  createdBy   Int?
  creator     User?           @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  cards       FlashcardCard[]
}

model FlashcardCard {
  id                 Int                 @id @default(autoincrement())
  deckId             Int
  deck               FlashcardDeck       @relation(fields: [deckId], references: [id], onDelete: Cascade)
  korean             String              // Từ vựng / câu tiếng Hàn
  vietnamese         String              // Nghĩa tiếng Việt
  english            String?             // Nghĩa tiếng Anh
  hanja              String?             // Chữ Hán tương ứng
  romaji             String?             // Phiên âm Latinh
  exampleSentence    String?             // Ví dụ tiếng Hàn
  exampleTranslation String?             // Dịch ví dụ
  notes              String?
  order              Int                 @default(0)
  createdAt          DateTime            @default(now())
  progress           FlashcardProgress[]
}

model FlashcardProgress {
  id             Int           @id @default(autoincrement())
  userId         Int
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId         Int
  card           FlashcardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  state          String        @default("NEW") // NEW | LEARNING | REVIEW | MASTERED
  interval       Int           @default(0)     // Số ngày giãn cách cho lần ôn tiếp theo
  repetition     Int           @default(0)     // Số lần nhớ liên tiếp
  easeFactor     Float         @default(2.5)   // Hệ số độ dễ SuperMemo SM-2
  nextReviewDate DateTime      @default(now())
  lastReviewedAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([userId, cardId])
}

